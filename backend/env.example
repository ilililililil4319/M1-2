# backend/.env.example
# 실제 값은 절대 이 파일에 적지 마세요. backend/.env 파일을 별도로 만들어 실제 값을 넣으세요.
# backend/.env는 .gitignore에 등록되어 있어 GitHub에 올라가지 않습니다.

# 코디세이 API 키 (AI 챗봇용)
CODYSSEY_API_KEY=

# Open DART API 키 (재무 데이터 수집용)
DART_API_KEY=

# CORS 허용 오리진 (콤마로 구분, 공백 없이)
# 로컬 개발 예시:
# ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# 배포 시 예시 (Vercel 프론트 주소 추가):
# ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-app.vercel.app
ALLOWED_ORIGINS=

# Firebase 서비스 계정 키 (JSON 문자열 전체를 한 줄로)
FIREBASE_SERVICE_ACCOUNT_JSON=
